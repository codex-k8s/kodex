{
  "schema_version": 1,
  "profile": "direct-production single-node prototype",
  "namespace": "mattercodex-system",
  "external_bindings": [
    {
      "kind": "Secret",
      "name": "automation-scheduler-application-grant",
      "keys": [
        "application-grant.jws"
      ],
      "requirement": "точный workload application grant, выпущенный владельцем"
    },
    {
      "kind": "Secret",
      "name": "control-api-gateway-application-grant",
      "keys": [
        "readiness.jwt"
      ],
      "requirement": "точный control-plane readiness grant, выпущенный владельцем"
    },
    {
      "kind": "Secret",
      "name": "control-plane-application-grants",
      "keys": [
        "control-plane.agent-session.public.jwk",
        "control-plane.artifact-scanner.public.jwk",
        "control-plane.automation.public.jwk",
        "control-plane.integration-continuation.public-keyset.json",
        "control-plane.integration-gateway.public.jwk",
        "control-plane.integration-git-reconciliation.public.jwk",
        "control-plane.integration-provider-readback.public.jwk",
        "control-plane.interaction-gateway.public-keyset.json",
        "control-plane.interaction-provider-readback.public.jwk",
        "control-plane.legacy-data-migration.public.jwk",
        "control-plane.memory-indexer.public.jwk",
        "control-plane.owner-gate-delivery.public.jwk",
        "control-plane.runtime-archive.public.jwk",
        "control-plane.runtime-cleanup-authorizer.public.jwk",
        "control-plane.runtime-controller.public.jwk",
        "control-plane.runtime-restore-effect.public.jwk",
        "control-plane.runtime-restore-verifier.public.jwk"
      ],
      "requirement": "публичное доверие для независимо выпускаемых владельцем application grants"
    },
    {
      "kind": "Secret",
      "name": "integration-gateway-application-grant",
      "keys": [
        "readiness.jwt"
      ],
      "requirement": "точный control-plane readiness grant, выпущенный владельцем"
    },
    {
      "kind": "Secret",
      "name": "integration-gateway-provider-health-credential",
      "keys": [
        "token"
      ],
      "requirement": "credential от точного внешнего provider-health authority"
    },
    {
      "kind": "Secret",
      "name": "interaction-gateway-mapping",
      "keys": [
        "manifest.sha256",
        "manifest.yaml",
        "revision"
      ],
      "requirement": "принадлежащая окружению immutable revision Mattermost mapping"
    },
    {
      "kind": "Secret",
      "name": "interaction-gateway-runtime",
      "keys": [
        "owner-gate-delivery.jwt"
      ],
      "requirement": "точный delivery grant владельца; остальные ключи генерируются, выводятся или переиспользуются"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-automation-scheduler-manifest-trust",
      "keys": [
        "bundle.jws"
      ],
      "requirement": "bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-control-api-gateway-manifest-trust",
      "keys": [
        "bundle.jws"
      ],
      "requirement": "bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-control-plane-manifest-trust",
      "keys": [
        "bundle.jws"
      ],
      "requirement": "bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-integration-gateway-manifest-trust",
      "keys": [
        "bundle.jws"
      ],
      "requirement": "bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-interaction-gateway-manifest-trust",
      "keys": [
        "bundle.jws"
      ],
      "requirement": "bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-publisher-manifest-trust",
      "keys": [
        "manifest-trust.jws"
      ],
      "requirement": "publisher trust bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-readback-trust",
      "keys": [
        "credential-trust.jws",
        "manifest-root.jws"
      ],
      "requirement": "readback credential/root bundles, подписанные соответствующими offline roots"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-restore-role-trust",
      "keys": [
        "restore-role-trust.jws"
      ],
      "requirement": "restore-role bundle, подписанный независимым manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-runtime-controller-manifest-trust",
      "keys": [
        "bundle.jws"
      ],
      "requirement": "bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "internal-rpc-authority-runtime-restore-effect-manifest-trust",
      "keys": [
        "bundle.jws"
      ],
      "requirement": "bundle, подписанный offline manifest root"
    },
    {
      "kind": "Secret",
      "name": "runtime-controller-application-grant",
      "keys": [
        "application-grant.jws"
      ],
      "requirement": "точный workload application grant, выпущенный владельцем"
    },
    {
      "kind": "Secret",
      "name": "runtime-restore-effect-application-grant",
      "keys": [
        "application-grant.jws"
      ],
      "requirement": "точный restore-effect application grant, выпущенный владельцем"
    },
    {
      "kind": "Secret",
      "name": "runtime-s3-archive-exchanger-config",
      "keys": [
        "archive-role-arn",
        "kms-key-arn"
      ],
      "requirement": "внешние идентификаторы archive KMS и role"
    },
    {
      "kind": "Secret",
      "name": "runtime-s3-restore-exchanger-config",
      "keys": [
        "kms-key-arn",
        "restore-role-arn"
      ],
      "requirement": "внешние идентификаторы restore KMS и role"
    },
    {
      "kind": "ConfigMap",
      "name": "internal-rpc-authority-vault-ca",
      "keys": [
        "ca.pem"
      ],
      "requirement": "CA bundle точного внешнего Vault endpoint"
    },
    {
      "kind": "ConfigMap",
      "name": "mattercodex-oidc-ca",
      "keys": [
        "ca.pem"
      ],
      "requirement": "CA bundle точного внешнего OIDC issuer"
    }
  ],
  "reusable_bindings": [
    {
      "target_kind": "Secret",
