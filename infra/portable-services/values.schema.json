{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storage": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "registry": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "nginx": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        },
        "preparer": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./:_-]*@sha256:[a-f0-9]{64}$"
        }
      },
      "required": [
        "storage",
        "registry",
        "nginx",
        "preparer"
      ]
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Gi|Mi)$"
        },
        "storageClass": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "ui": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ]
        },
        "trustedProxyCIDRs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9a-f:]+/128$"
          }
        }
      },
      "required": [
        "enabled",
        "authSecret",
        "size",
        "storageClass",
        "ui",
        "trustedProxyCIDRs"
      ]
    },
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "authSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "size": {
          "type": "string",
          "pattern": "^[1-9][0-9]*(Gi|Mi)$"
        },
        "storageClass": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "writerUsername": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "readerUsername": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{2,63}$"
        },
        "repositoryPrefix": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]*(/[a-z0-9][a-z0-9_-]*)*$"
        },
        "expose": {
          "type": "boolean"
        },
        "internalClients": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "namespace",
              "podLabels"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "maxLength": 63,
                "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
              },
              "podLabels": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 8,
                "propertyNames": {
                  "pattern": "^([a-z0-9][a-z0-9.-]*/)?[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[A-Za-z0-9]([A-Za-z0-9_.-]*[A-Za-z0-9])?$"
                }
              }
            }
          }
        },
        "nodeCIDRs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(([0-9]{1,3}\\.){3}[0-9]{1,3}/32|[0-9a-f:]+/128)$"
          }
        }
      },
      "required": [
        "enabled",
        "authSecret",
        "size",
        "storageClass",
        "writerUsername",
        "readerUsername",
        "repositoryPrefix"
      ]
    },
    "pki": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "existing",
            "isolated"
          ]
        },
        "issuerName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "issuerKind": {
          "type": "string",
          "enum": [
            "Issuer",
            "ClusterIssuer"
          ]
        }
      },
      "required": [
        "mode",
        "issuerName",
        "issuerKind"
      ]
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "disabled",
            "shared_host",
            "separate_hosts"
          ]
        },
        "tlsMode": {
          "type": "string",
          "enum": [
            "managed",
            "external"
          ]
        },
        "tlsSecret": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "sharedHost": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "s3Host": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "storageHost": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "registryHost": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "s3Prefix": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9_-]*)*$",
          "maxLength": 128
        },
        "storagePrefix": {
          "type": "string",
          "pattern": "^/[A-Za-z0-9][A-Za-z0-9_-]*(/[A-Za-z0-9][A-Za-z0-9_-]*)*$",
          "maxLength": 128
        },
        "trustedProxyCIDRs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/32$|^[0-9a-f:]+/128$"
          }
        }
      },
      "required": [
        "mode",
        "tlsMode",
        "tlsSecret",
        "sharedHost",
        "s3Host",
        "storageHost",
        "registryHost",
        "s3Prefix",
        "storagePrefix",
        "trustedProxyCIDRs"
      ]
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "namespace": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        },
        "podName": {
          "type": "string",
          "pattern": "^$|^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"
        }
      },
      "required": [
        "class",
        "namespace",
        "podName"
      ]
    },
    "credentialsRevision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
    },
    "trustBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "namespaces"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "namespaces": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63,
            "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"
          }
        }
      }
    }
  },
  "required": [
    "images",
    "storage",
    "registry",
    "pki",
    "exposure",
    "ingress",
    "credentialsRevision"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#"
}
