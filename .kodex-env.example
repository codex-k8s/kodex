# Режим: bare-metal устанавливает инфраструктуру и Kodex; existing-kubernetes
# не меняет хост и устанавливает Kodex в отдельный namespace.
KODEX_INSTALL_MODE=bare-metal
KODEX_NAMESPACE=kodex-system
KODEX_KUBECONFIG=/etc/rancher/k3s/k3s.yaml
KODEX_KUBE_CONTEXT=default

# Bare-metal host и публичные DNS. Все DNS должны заранее указывать на сервер.
KODEX_SERVER_PUBLIC_IP=203.0.113.10
# Необязательный точный глобальный IPv6 адрес bare-metal сервера. Если задан,
# host installer поднимает code-owned raw TCP bridge для 80/443 на IPv4 ingress.
# Если AAAA записей нет, оставьте значение пустым: bridge создан не будет.
KODEX_SERVER_PUBLIC_IPV6_ADDRESS=
KODEX_PUBLIC_IPV4_CIDR=203.0.113.10/32
KODEX_CONTROL_HOST=control.kodex.example.com
# deferred не создаёт публичный ACME Certificate и используется только до
# разрешённого окна выдачи. enabled является каноническим режимом релиза.
KODEX_PUBLIC_TLS_MODE=enabled
# Exact comma-separated external ingress addresses. Списки должны в точности
# совпадать с объединением A/AAAA всех SAN публичного Certificate. Wildcard,
# CIDR, пробелы и неиспользуемые запасные адреса запрещены. Для IPv4-only
# установки список IPv6 оставляется пустым и ни один SAN не должен иметь AAAA.
KODEX_PUBLIC_TLS_ALLOWED_IPV4_ADDRESSES=203.0.113.10
KODEX_PUBLIC_TLS_ALLOWED_IPV6_ADDRESSES=
# Bounded DNS lookup и HTTP port 80 probe для каждого SAN/address.
KODEX_PUBLIC_TLS_DNS_TIMEOUT_SECONDS=10
KODEX_PUBLIC_TLS_HTTP_TIMEOUT_SECONDS=10
# Необязательный отдельный DNS для восстановления после ACME duplicate-certificate
# rate limit. Он должен указывать на тот же ingress и оставаться стабильным до
# следующей плановой ротации сертификата.
KODEX_CONTROL_TLS_RECOVERY_HOST=
KODEX_OIDC_HOST=sso.kodex.example.com
KODEX_OIDC_CONNECT_ADDRESS=sso.identity.svc.cluster.local:443
KODEX_OIDC_TLS_SERVER_NAME=sso.kodex.example.com
KODEX_OIDC_NAMESPACE=identity
KODEX_OIDC_POD_NAME=sso
KODEX_OIDC_POD_COMPONENT=identity-provider
KODEX_OIDC_TARGET_PORT=8443
KODEX_GRAFANA_HOST=grafana.kodex.example.com
KODEX_HEADLAMP_HOST=headlamp.kodex.example.com
KODEX_REGISTRY_HOST=registry.kodex.example.com
KODEX_PROMOTED_PULL_HOST=images.kodex.example.com

# Kubernetes и TLS.
KODEX_INGRESS_CLASS=traefik
KODEX_CLUSTER_ISSUER=letsencrypt-production
KODEX_ACME_EMAIL=owner@example.com
KODEX_ACME_SERVER=https://acme-v02.api.letsencrypt.org/directory
KODEX_INGRESS_NAMESPACE=kube-system
KODEX_INGRESS_POD_NAME=traefik
KODEX_INGRESS_SERVICE_NAME=traefik

# Постоянный Keycloak administrator и первый владелец Kodex.
KODEX_KEYCLOAK_ADMIN_USERNAME=kodex-admin
KODEX_KEYCLOAK_ADMIN_INITIAL_PASSWORD=replace-with-at-least-20-characters
KODEX_OWNER_USERNAME=owner
KODEX_OWNER_EMAIL=owner@example.com
KODEX_OWNER_INITIAL_PASSWORD=replace-with-another-20-character-password

# GitHub PAT с repository administration и Actions runner scopes.
KODEX_GITHUB_ARC_TOKEN=github_pat_replace_me
KODEX_GITHUB_OWNER_PAT=github_pat_replace_me

# Только для existing-kubernetes без bundled registry: точная write identity
# уже существующего HTTPS OCI registry. Значения не нужны при компоненте registry.
KODEX_RELEASE_REGISTRY_USERNAME=
KODEX_RELEASE_REGISTRY_PASSWORD=

# Codex auth.json в base64 без переносов либо путь к локальному файлу.
KODEX_OPENAI_AUTH_JSON_B64=eyJyZXBsYWNlIjoibWUifQ==
# KODEX_OPENAI_AUTH_JSON_FILE=/absolute/path/to/auth.json

# В bundled MVP Prometheus-метрики остаются включены, а внешние tracing/Sentry
# exporters отключены до установки совместимых OTel Collector и Sentry Relay.
KODEX_SENTRY_DSN=
KODEX_DISABLE_OBSERVABILITY=true

# Внешний S3-compatible bucket обязателен для production application-профиля.
# Локальный hot-reload вместо этих параметров поднимает SeaweedFS внутри k3s.
KODEX_S3_ENDPOINT=https://s3.example.com
KODEX_S3_REGION=us-east-1
KODEX_S3_BUCKET=kodex-artifacts
KODEX_S3_ACCESS_KEY=
KODEX_S3_SECRET_KEY=
