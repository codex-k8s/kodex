# syntax=docker.io/docker/dockerfile:1.19.0@sha256:b6afd42430b15f2d2a4c5a02b919e98a525b785b1aaff16747d2f623364e39b6

FROM docker.io/library/golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS go

FROM docker.io/library/alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40 AS runtime
RUN apk add --no-cache ffmpeg=8.0.1-r1 ca-certificates=20260611-r0
COPY --from=go /usr/local/go/ /usr/local/go/
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local GOPATH=/go
RUN test "$(go env GOVERSION)" = "go1.26.6" && ffmpeg -version >/dev/null
USER 10001:10001
WORKDIR /workspace/services/internal/stt-tts-service
ENTRYPOINT ["/workspace/tools/dev/run-go-hot-reload.sh"]
CMD ["services/internal/stt-tts-service", "./cmd/stt-tts-service", "stt-tts-service"]
