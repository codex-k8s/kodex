# syntax=docker.io/docker/dockerfile:1.19.0@sha256:b6afd42430b15f2d2a4c5a02b919e98a525b785b1aaff16747d2f623364e39b6

FROM docker.io/library/golang:1.26.10-alpine@sha256:87c65a688975c0b1d4585d204874c45ca78354670e3a5f11368c5a492303d696 AS go

# Изолированная unit-среда без запуска сервиса и без изменения финального runtime.
FROM docker.io/library/alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40 AS unit-test
RUN apk add --no-cache ffmpeg=8.0.1-r1
COPY --from=go /usr/local/go/ /usr/local/go/
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local GOPATH=/go
WORKDIR /workspace/services/internal/stt-tts-service
ENTRYPOINT ["go"]
CMD ["test", "-count=1", "./..."]

FROM docker.io/library/alpine:3.23@sha256:fd791d74b68913cbb027c6546007b3f0d3bc45125f797758156952bc2d6daf40 AS runtime
RUN apk add --no-cache ffmpeg=8.0.1-r1 ca-certificates=20261020-r0
COPY --from=go /usr/local/go/ /usr/local/go/
ENV PATH=/usr/local/go/bin:$PATH GOTOOLCHAIN=local GOPATH=/go
RUN test "$(go env GOVERSION)" = "go1.26.10" && ffmpeg -version >/dev/null
USER 10001:10001
WORKDIR /workspace/services/internal/stt-tts-service
ENTRYPOINT ["/workspace/tools/dev/run-go-hot-reload.sh"]
CMD ["services/internal/stt-tts-service", "./cmd/stt-tts-service", "stt-tts-service"]
