{
  "name": "@kodex/staff-control-center",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=11.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --build --force",
    "test:unit": "vitest run",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:discovery": "KODEX_E2E_DISCOVERY=1 playwright test --config playwright.discovery.config.ts",
    "test:e2e:check": "tsc --noEmit -p tsconfig.e2e.json && KODEX_E2E_CHECK_ONLY=1 KODEX_E2E_PROFILE=web-only playwright test --list && KODEX_E2E_CHECK_ONLY=1 KODEX_E2E_PROFILE=mattermost playwright test --list && KODEX_E2E_CHECK_ONLY=1 KODEX_E2E_DISCOVERY=1 KODEX_E2E_PROFILE=web-only playwright test --config playwright.discovery.config.ts --list && KODEX_E2E_CHECK_ONLY=1 playwright test --config playwright.auth.config.ts --list && KODEX_E2E_CHECK_ONLY=1 playwright test --config playwright.local.config.ts --list",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "config:check": "node tools/check-runtime-config.mjs",
    "generate:openapi": "openapi-ts -f openapi-ts.config.mjs",
    "validate:asyncapi": "node tools/generate-asyncapi.mjs --validate-only",
    "generate:asyncapi": "node tools/generate-asyncapi.mjs",
    "codegen": "npm run generate:openapi && npm run generate:asyncapi"
  },
  "dependencies": {
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.3",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.9",
    "@hey-api/client-fetch": "0.13.1",
    "@lucide/vue": "1.30.0",
    "codemirror": "6.0.2",
    "oidc-client-ts": "3.3.0",
    "pinia": "3.0.4",
    "vue": "3.5.41",
    "vue-i18n": "11.4.8",
    "vue-router": "4.6.3"
  },
  "devDependencies": {
    "@asyncapi/parser": "3.6.3",
    "@eslint/js": "9.39.2",
    "@hey-api/openapi-ts": "0.99.0",
    "@playwright/test": "1.61.0",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.8",
    "eslint": "9.39.2",
    "eslint-plugin-vue": "10.7.0",
    "globals": "16.5.0",
    "js-yaml": "4.3.1",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.52.0",
    "vite": "8.0.16",
    "vitest": "4.1.6",
    "vue-tsc": "3.3.5"
  },
  "overrides": {
    "@hey-api/json-schema-ref-parser@1.4.4": {
      "js-yaml": "4.3.1"
    }
  }
}
