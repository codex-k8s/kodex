{
  "rbac": [
    {
      "kind": "Role",
      "name": "matter-codex-bot-service-runtime",
      "rules": [
        "apiGroups=core;resources=persistentvolumeclaims;verbs=create,get,list,delete",
        "apiGroups=core;resources=configmaps;verbs=create,get,list,delete",
        "apiGroups=core;resources=pods;verbs=create,get,list,delete",
        "apiGroups=core;resources=pods/log;verbs=get",
        "apiGroups=core;resources=pods/exec;verbs=create",
        "apiGroups=core;resources=secrets;verbs=create,get,list,update,patch,delete",
        "apiGroups=batch;resources=jobs;verbs=create,get,list,delete"
      ]
    },
    {
      "kind": "RoleBinding",
      "name": "matter-codex-bot-service-runtime",
      "role_ref": "Role/matter-codex-bot-service-runtime",
      "subjects": [
        "ServiceAccount/matter-codex-bot-service"
      ]
    },
    {
      "kind": "Role",
      "name": "matter-codex-agent-runner-readonly",
      "rules": [
        "apiGroups=core;resources=pods,pods/log,services,endpoints,configmaps,persistentvolumeclaims,events;verbs=get,list,watch",
        "apiGroups=apps;resources=deployments,statefulsets,daemonsets,replicasets;verbs=get,list,watch",
        "apiGroups=batch;resources=jobs,cronjobs;verbs=get,list,watch",
        "apiGroups=networking.k8s.io;resources=ingresses;verbs=get,list,watch"
      ]
    },
    {
      "kind": "RoleBinding",
      "name": "matter-codex-agent-runner-readonly",
      "role_ref": "Role/matter-codex-agent-runner-readonly",
      "subjects": [
        "ServiceAccount/${MATTERCODEX_AGENT_RUNNER_SERVICE_ACCOUNT}"
      ]
    },
    {
      "kind": "ClusterRoleBinding",
      "name": "matter-codex-agent-runner-cluster-admin",
      "role_ref": "ClusterRole/cluster-admin",
      "subjects": [
        "ServiceAccount/${MATTERCODEX_AGENT_RUNNER_CLUSTER_ADMIN_SERVICE_ACCOUNT}"
      ]
    }
  ],
  "pod": {
    "service_account": "matter-codex-bot-service",
    "security_context": {
      "fsGroup": 29000,
      "fsGroupChangePolicy": "OnRootMismatch",
      "runAsGroup": 10001,
      "runAsNonRoot": true,
      "runAsUser": 10001,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "init_containers": [
      {
        "name": "internal-rpc-authority-socket-init",
        "security_context": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 29000,
          "runAsNonRoot": true,
          "runAsUser": 29000
        },
        "secret_refs": null
      },
      {
        "name": "wait-for-postgres",
        "security_context": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true
        },
        "secret_refs": null
      }
    ],
    "containers": [
      {
        "name": "bot-service",
        "security_context": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true
        },
        "secret_refs": [
          "${MATTERCODEX_BOT_SERVICE_SECRET}/mattermost-admin-token",
          "${MATTERCODEX_BOT_SERVICE_SECRET}/mattermost-bot-token",
          "${MATTERCODEX_BOT_SERVICE_SECRET}/mattermost-slash-token",
          "${MATTERCODEX_GITHUB_SECRET}/github-token",
          "${MATTERCODEX_GITHUB_SECRET}/github-webhook-secret",
          "${MATTERCODEX_POSTGRES_SECRET}/bot-service-runtime-datasource",
          "${MATTERCODEX_POSTGRES_SECRET}/mattermost-datasource"
        ]
      },
      {
        "name": "internal-rpc-authority-issuer",
        "security_context": {
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          },
          "readOnlyRootFilesystem": true,
          "runAsGroup": 29000,
          "runAsNonRoot": true,
          "runAsUser": 29001
        },
        "secret_refs": [
          "internal-rpc-authority-bot-service-issuer-postgresql/username"
        ]
      }
    ],
    "secret_volumes": [
      "${MATTERCODEX_BOT_SERVICE_CONTROL_PLANE_TLS_SECRET}",
      "${MATTERCODEX_BOT_SERVICE_RUNTIME_TLS_SECRET}",
      "internal-rpc-authority-bot-service-issuer-key",
      "internal-rpc-authority-bot-service-issuer-postgresql",
      "internal-rpc-authority-bot-service-manifest-trust",
      "internal-rpc-authority-bot-service-proof-trust",
      "internal-rpc-authority-snapshot"
    ]
  },
  "network_policies": [
    "base/agent-runner/networkpolicy.yaml",
    "base/control-api-gateway/networkpolicy.yaml",
    "base/control-plane/networkpolicy.yaml",
    "base/image-supply-chain/networkpolicy.yaml",
    "base/integration-gateway/egress-proxy.yaml",
    "base/integration-gateway/networkpolicy.yaml",
    "base/integration-gateway/postgresql.yaml",
    "base/interaction-gateway/networkpolicy.yaml",
    "base/internal-rpc-authority-data/networkpolicy.yaml",
    "base/internal-rpc-authority-publisher/networkpolicy.yaml",
    "base/internal-rpc-authority-readback-attestor/networkpolicy.yaml",
    "base/internal-rpc-authority-restore/networkpolicy.yaml",
    "base/internal-rpc-authority/networkpolicy.yaml",
    "base/runtime-controller/networkpolicy.yaml",
    "bot-service/networkpolicy.yaml.tpl",
    "components/internal-rpc-authority-control-api-gateway-issuer/networkpolicy.yaml",
    "components/internal-rpc-authority-control-plane-verifier/networkpolicy.yaml",
    "components/internal-rpc-authority-runtime-controller-issuer/networkpolicy.yaml"
  ]
}
