{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kodex:contract:model-provider-catalog:v1",
  "title": "Каталог маршрутов OpenCode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "managed_by",
    "source_revision",
    "default_provider",
    "default_model",
    "providers"
  ],
  "properties": {
    "schema": {
      "const": "kodex.model-provider-catalog/v1"
    },
    "managed_by": {
      "const": "git"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "default_provider": {
      "type": "string",
      "pattern": "^opencode-[a-z0-9]([a-z0-9-]*[a-z0-9])?$",
      "maxLength": 72
    },
    "default_model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "urn:kodex:contract:runtime:agent-runner-input:v10#/$defs/model_provider"
      }
    }
  }
}
