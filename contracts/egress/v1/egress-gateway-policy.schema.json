{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codex-k8s/kodex/contracts/egress/v1/egress-gateway-policy.schema.json",
  "title": "Kodex egress gateway policy v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "kodex.io/v1alpha1"},
    "kind": {"const": "EgressGatewayPolicy"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "revision"],
      "properties": {
        "name": {"const": "egress-gateway"},
        "revision": {"type": "string", "minLength": 3, "maxLength": 64, "pattern": "^[A-Za-z0-9._-]+$"}
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dns", "limits", "destinations"],
      "properties": {
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimumTTLSeconds", "maximumTTLSeconds", "maximumCacheEntries", "maximumQueries", "maximumCnameDepth", "maximumRecords", "maximumMessageBytes", "queryTimeoutMilliseconds"],
          "properties": {
            "minimumTTLSeconds": {"type": "integer", "minimum": 5, "maximum": 300},
            "maximumTTLSeconds": {"type": "integer", "minimum": 5, "maximum": 3600},
            "maximumCacheEntries": {"type": "integer", "minimum": 4, "maximum": 256},
            "maximumQueries": {"type": "integer", "minimum": 2, "maximum": 32},
            "maximumCnameDepth": {"type": "integer", "minimum": 1, "maximum": 16},
            "maximumRecords": {"type": "integer", "minimum": 4, "maximum": 256},
            "maximumMessageBytes": {"type": "integer", "minimum": 512, "maximum": 65536},
            "queryTimeoutMilliseconds": {"type": "integer", "minimum": 100, "maximum": 10000}
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "required": ["maximumHeaderBytes", "maximumClientHelloBytes", "maximumConnections", "maximumConnectionsPerSource", "headerTimeoutMilliseconds", "clientHelloTimeoutMilliseconds", "dialTimeoutMilliseconds", "idleTimeoutMilliseconds", "writeTimeoutMilliseconds", "shutdownTimeoutMilliseconds"],
          "properties": {
            "maximumHeaderBytes": {"type": "integer", "minimum": 1024, "maximum": 65536},
            "maximumClientHelloBytes": {"type": "integer", "minimum": 1024, "maximum": 131072},
            "maximumConnections": {"type": "integer", "minimum": 8, "maximum": 4096},
            "maximumConnectionsPerSource": {"type": "integer", "minimum": 1, "maximum": 4096},
            "headerTimeoutMilliseconds": {"type": "integer", "minimum": 500, "maximum": 30000},
            "clientHelloTimeoutMilliseconds": {"type": "integer", "minimum": 500, "maximum": 30000},
            "dialTimeoutMilliseconds": {"type": "integer", "minimum": 100, "maximum": 30000},
            "idleTimeoutMilliseconds": {"type": "integer", "minimum": 1000, "maximum": 1800000},
            "writeTimeoutMilliseconds": {"type": "integer", "minimum": 100, "maximum": 30000},
            "shutdownTimeoutMilliseconds": {"type": "integer", "minimum": 1000, "maximum": 20000}
          }
        },
        "profiles": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "workload", "operation", "destinations"],
            "properties": {
              "name": {"const": "openai-stt"},
              "workload": {"const": "stt-tts-service"},
              "operation": {"const": "openai.transcription"},
              "destinations": {
                "type": "array",
                "minItems": 1,
                "maxItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["hostname", "port"],
                  "properties": {
                    "hostname": {"const": "api.openai.com"},
                    "port": {"const": 443}
                  }
                }
              }
            }
          }
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hostname", "port"],
            "properties": {
              "hostname": {"type": "string", "minLength": 4, "maxLength": 253, "pattern": "^([a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
              "port": {"const": 443}
            }
          }
        }
      }
    }
  }
}
