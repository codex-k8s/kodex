{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattercodex.dev/contracts/runtime-controller/v2/agent-runner-input.schema.json",
  "title": "MatterCodex agent-runner runtime input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "execution_id", "execution_version", "fence", "grant_generation",
    "runtime_revision_id", "runtime_revision_version", "runtime_revision_sha256",
    "effective_runtime_sha256", "immutable_input_sha256", "session_id", "turn_id",
    "attempt", "session_key", "provider_binding_id", "provider_account_name",
    "mcp_binding_version", "provider_binding_version",
    "provider_binding_sha256", "credential_snapshot_sha256", "workload_ticket_sha256",
    "agent_profile", "codex_model", "codex_sandbox", "codex_approval_policy", "codex_session_id",
    "codex_archive_relative_path", "codex_archive_sha256", "codex_archive_provenance",
    "codex_delivery_recovery_source_execution_id",
    "control_plane", "mcp", "interaction_gateway", "credential_files",
    "materializations", "prompt_path", "instructions_path", "workspace_root", "outbox_root",
    "codex_home", "mattermost_post_max_runes", "handoff_config_map", "pod_namespace"
  ],
  "properties": {
    "schema": {"const": "mattercodex.agent-runner-input.v2"},
    "execution_id": {"type": "string", "format": "uuid"},
    "execution_version": {"type": "integer", "minimum": 1},
    "fence": {"type": "integer", "minimum": 1},
    "grant_generation": {"type": "integer", "minimum": 1},
    "runtime_revision_id": {"type": "string", "format": "uuid"},
    "runtime_revision_version": {"type": "integer", "minimum": 1},
    "runtime_revision_sha256": {"$ref": "#/$defs/sha256"},
    "effective_runtime_sha256": {"$ref": "#/$defs/sha256"},
    "immutable_input_sha256": {"$ref": "#/$defs/sha256"},
    "session_id": {"type": "string", "format": "uuid"},
    "turn_id": {"type": "string", "format": "uuid"},
    "schedule_occurrence_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "session_key": {"type": "string", "minLength": 1, "maxLength": 256},
    "provider_binding_id": {"type": "string", "format": "uuid"},
    "provider_account_name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]{0,47}[a-z0-9])?$"},
    "mcp_binding_version": {"type": "integer", "minimum": 1},
    "provider_binding_version": {"type": "integer", "minimum": 1},
    "provider_binding_sha256": {"$ref": "#/$defs/sha256"},
    "credential_snapshot_sha256": {"$ref": "#/$defs/sha256"},
    "workload_ticket_sha256": {"$ref": "#/$defs/sha256"},
    "agent_profile": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
    "codex_model": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$"},
    "codex_sandbox": {"enum": ["read-only", "workspace-write"]},
    "codex_approval_policy": {"enum": ["untrusted", "on-request", "never"]},
    "codex_session_id": {"oneOf": [{"const": ""}, {"type": "string", "format": "uuid"}]},
    "codex_archive_relative_path": {"oneOf": [{"const": ""}, {"type": "string", "pattern": "^\\.matter-codex/state/codex-home/sessions/[0-9]{4}/[0-9]{2}/[0-9]{2}/rollout-[A-Za-z0-9._-]+\\.jsonl$"}]},
    "codex_archive_sha256": {"oneOf": [{"const": ""}, {"$ref": "#/$defs/sha256"}]},
    "codex_archive_provenance": {"oneOf": [
      {"const": ""},
      {"type": "string", "maxLength": 1024, "pattern": "^codex-app-server-rollout-v1:[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}:\\.matter-codex/state/codex-home/sessions/[0-9]{4}/[0-9]{2}/[0-9]{2}/rollout-[A-Za-z0-9._-]+\\.jsonl:[0-9a-f]{64}$"}
    ]},
    "codex_delivery_recovery_source_execution_id": {"oneOf": [{"const": ""}, {"type": "string", "format": "uuid"}]},
    "control_plane": {"$ref": "#/$defs/grpc_binding"},
    "mcp": {"$ref": "#/$defs/http_binding"},
    "interaction_gateway": {"$ref": "#/$defs/http_binding"},
    "credential_files": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "control_plane_grant", "mcp_token", "materialization_token", "codex_auth", "codex_auth_sha256",
        "handoff_private_key", "handoff_key_id"
      ],
      "properties": {
        "control_plane_grant": {"$ref": "#/$defs/secret_path"},
        "mcp_token": {"$ref": "#/$defs/secret_path"},
        "materialization_token": {"$ref": "#/$defs/secret_path"},
        "codex_auth": {"$ref": "#/$defs/secret_path"},
        "codex_auth_sha256": {"$ref": "#/$defs/sha256"},
        "handoff_private_key": {"$ref": "#/$defs/secret_path"},
        "handoff_key_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "materializations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "artifact_id", "artifact_version", "sha256", "size_bytes", "relative_path", "media_type"],
        "properties": {
          "kind": {"enum": ["PROMPT", "INSTRUCTION", "REPOSITORY", "WORKSPACE", "ATTACHMENT", "SESSION_ARCHIVE"]},
          "artifact_id": {"type": "string", "format": "uuid"},
          "artifact_version": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "size_bytes": {"type": "integer", "minimum": 1, "maximum": 67108864},
          "relative_path": {"type": "string", "pattern": "^[^/\\\\](?:[^\\x00\\r\\n]*[^/\\\\])?$", "maxLength": 1024},
          "media_type": {"type": "string", "minLength": 1, "maxLength": 255}
        }
      }
    },
    "prompt_path": {"const": ".matter-codex/inbox/prompt.md"},
    "instructions_path": {"const": "AGENTS.md"},
    "workspace_root": {"const": "/workspace"},
    "outbox_root": {"const": "/workspace/.matter-codex/outbox"},
    "codex_home": {"const": "/workspace/.matter-codex/state/codex-home"},
    "mattermost_post_max_runes": {"const": 16383}
    ,"handoff_config_map": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"}
    ,"pod_namespace": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?$"}
  },
  "allOf": [{
    "if": {
      "properties": {"codex_delivery_recovery_source_execution_id": {"not": {"const": ""}}},
      "required": ["codex_delivery_recovery_source_execution_id"]
    },
    "then": {"properties": {
      "attempt": {"minimum": 2},
      "codex_session_id": {"type": "string", "format": "uuid"},
      "codex_archive_relative_path": {"not": {"const": ""}},
      "codex_archive_sha256": {"$ref": "#/$defs/sha256"},
      "codex_archive_provenance": {"not": {"const": ""}}
    }}
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "secret_path": {"type": "string", "pattern": "^/var/run/secrets/", "maxLength": 1024},
    "tls_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_name", "ca_file", "certificate_file", "private_key_file", "binding_sha256"],
      "properties": {
        "server_name": {"type": "string", "pattern": "^[a-z0-9.-]+\\.svc\\.cluster\\.local$"},
        "ca_file": {"$ref": "#/$defs/secret_path"},
        "certificate_file": {"$ref": "#/$defs/secret_path"},
        "private_key_file": {"$ref": "#/$defs/secret_path"},
        "binding_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "grpc_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "tls"],
      "properties": {
        "target": {"type": "string", "pattern": "^[a-z0-9.-]+\\.svc:[0-9]+$"},
        "tls": {"$ref": "#/$defs/tls_binding"}
      }
    },
    "http_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "tls"],
      "properties": {
        "url": {"type": "string", "format": "uri", "pattern": "^https://[^/]+\\.svc\\.cluster\\.local:[0-9]+(?:/.*)?$"},
        "tls": {"$ref": "#/$defs/tls_binding"}
      }
    }
  }
}
