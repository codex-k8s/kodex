{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kodex:contract:runtime:agent-runner-input:v6",
  "title": "Kodex agent runner input v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "mode",
    "workload_instance",
    "session_ref",
    "agent_ref",
    "runtime_revision_ref",
    "runtime_revision_version",
    "runtime_revision_digest",
    "image_reference",
    "image_manifest_digest",
    "role_runtime_contract_revision",
    "role_runtime_contract_sha256",
    "system_assistant",
    "instructions",
    "provider",
    "model",
    "provider_account_ref",
    "provider_credential_revision_ref",
    "provider_credential_revision",
    "provider_credential_sha256",
    "runtime_config_ref",
    "runtime_config_version",
    "runtime_config_digest",
    "provider_policy_ref",
    "provider_policy_version",
    "provider_policy_digest",
    "config_overlay_ref",
    "config_overlay_version",
    "config_overlay_digest",
    "config_overlay",
    "runtime_environment_ref",
    "runtime_environment_version",
    "runtime_environment_digest",
    "environment_binding_ref",
    "environment_binding_version",
    "environment_binding_digest",
    "codex_sandbox",
    "codex_approval_policy",
    "callback_url",
    "callback_tls",
    "execution_ticket_file",
    "provider_auth_file",
    "provider_auth_sha256_file",
    "workspace_root",
    "outbox_root",
    "codex_home"
  ],
  "properties": {
    "schema": {"const": "kodex.agent-runner-input.v6"},
    "mode": {"enum": ["TURN", "WARM"]},
    "workload_instance": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_ref": {"$ref": "#/$defs/opaque_ref"},
    "project_ref": {"$ref": "#/$defs/opaque_ref"},
    "node_ref": {"$ref": "#/$defs/opaque_ref"},
    "session_ref": {"$ref": "#/$defs/opaque_ref"},
    "turn_ref": {"$ref": "#/$defs/opaque_ref"},
    "agent_ref": {"$ref": "#/$defs/opaque_ref"},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "lease_ref": {"$ref": "#/$defs/opaque_ref"},
    "lease_fence": {"type": "string", "minLength": 1, "maxLength": 128},
    "lease_generation": {"type": "integer", "minimum": 1},
    "runtime_revision_ref": {
      "type": "string",
      "pattern": "^([a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{8,84}|system-assistant-core-v[1-9][0-9]*)$"
    },
    "runtime_revision_version": {"type": "integer", "minimum": 1},
    "runtime_revision_digest": {"$ref": "#/$defs/sha256"},
    "image_reference": {
      "type": "string",
      "minLength": 73,
      "maxLength": 512,
      "pattern": "^[^\\s$\\{\\}]+@sha256:[a-f0-9]{64}$"
    },
    "image_manifest_digest": {"$ref": "#/$defs/image_digest"},
    "role_runtime_contract_revision": {"type": "integer", "minimum": 1},
    "role_runtime_contract_sha256": {"$ref": "#/$defs/sha256"},
    "system_assistant": {"type": "boolean"},
    "instructions": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "task": {"type": "string", "minLength": 1, "maxLength": 1048576},
    "bounded_input": {"type": "object", "maxProperties": 256},
    "session_context": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/session_message"}
    },
    "delegation_targets": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/delegation_target"}
    },
    "integration_grants": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/integration_grant"}
    },
    "assistant_context": {"$ref": "#/$defs/assistant_context"},
    "attachment_set_ref": {"$ref": "#/$defs/opaque_ref"},
    "attachment_set_manifest_digest": {"$ref": "#/$defs/sha256"},
    "attachment_context": {
      "enum": ["ASSISTANT_MESSAGE", "SESSION_TURN", "RUN_INPUT", "WORKFLOW_INPUT", "OWNER_GATE_MESSAGE"]
    },
    "input_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/input_artifact"}
    },
    "capabilities": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 255}
    },
    "provider": {"type": "string", "minLength": 1, "maxLength": 64},
    "model": {"type": "string", "minLength": 1, "maxLength": 128},
    "provider_account_ref": {"$ref": "#/$defs/opaque_ref"},
    "provider_credential_revision_ref": {"$ref": "#/$defs/opaque_ref"},
    "provider_credential_revision": {"type": "integer", "minimum": 1},
    "provider_credential_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_config_ref": {"$ref": "#/$defs/opaque_ref"},
    "runtime_config_version": {"type": "integer", "minimum": 1},
    "runtime_config_digest": {"$ref": "#/$defs/sha256"},
    "provider_policy_ref": {"$ref": "#/$defs/opaque_ref"},
    "provider_policy_version": {"type": "integer", "minimum": 1},
    "provider_policy_digest": {"$ref": "#/$defs/sha256"},
    "config_overlay_ref": {"$ref": "#/$defs/opaque_ref"},
    "config_overlay_version": {"type": "integer", "minimum": 1},
    "config_overlay_digest": {"$ref": "#/$defs/sha256"},
    "config_overlay": {"type": "string", "maxLength": 65536},
    "runtime_environment_ref": {"$ref": "#/$defs/opaque_ref"},
    "runtime_environment_version": {"type": "integer", "minimum": 1},
    "runtime_environment_digest": {"$ref": "#/$defs/sha256"},
    "environment_binding_ref": {"$ref": "#/$defs/opaque_ref"},
    "environment_binding_version": {"type": "integer", "minimum": 1},
    "environment_binding_digest": {"$ref": "#/$defs/sha256"},
    "environment_values": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/environment_value"}
    },
    "secret_projections": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/secret_projection"}
    },
    "codex_sandbox": {"enum": ["read-only", "workspace-write"]},
    "codex_approval_policy": {"enum": ["untrusted", "on-request", "never"]},
    "codex_session_id": {"type": "string", "maxLength": 255},
    "callback_url": {
      "type": "string",
      "pattern": "^https://[^/?#]+:[0-9]+$",
      "maxLength": 512
    },
    "callback_tls": {"$ref": "#/$defs/tls_binding"},
    "execution_ticket_file": {"$ref": "#/$defs/secret_file"},
    "provider_auth_file": {"$ref": "#/$defs/secret_file"},
    "provider_auth_sha256_file": {"$ref": "#/$defs/secret_file"},
    "workspace_root": {"const": "/workspace"},
    "outbox_root": {"const": "/workspace/.kodex/outbox"},
    "codex_home": {"const": "/workspace/.kodex/state/codex-home"}
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "TURN"}}, "required": ["mode"]},
      "then": {
        "required": [
          "run_ref",
          "node_ref",
          "turn_ref",
          "attempt",
          "lease_ref",
          "lease_fence",
          "lease_generation",
          "task"
        ]
      }
    },
    {
      "if": {"properties": {"mode": {"const": "WARM"}}, "required": ["mode"]},
      "then": {
        "properties": {"system_assistant": {"const": true}},
        "not": {
          "anyOf": [
            {"required": ["run_ref"]},
            {"required": ["node_ref"]},
            {"required": ["turn_ref"]},
            {"required": ["attempt"]},
            {"required": ["lease_ref"]},
            {"required": ["lease_fence"]},
            {"required": ["lease_generation"]},
            {"required": ["task"]}
          ]
        }
      }
    },
    {
      "if": {"required": ["input_artifacts"]},
      "then": {
        "properties": {
          "capabilities": {"contains": {"const": "platform.artifact.manage"}}
        },
        "required": ["capabilities"]
      }
    }
  ],
  "$defs": {
    "opaque_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]{1,11}_[A-Za-z0-9_-]{8,84}$"
    },
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "secret_file": {
      "type": "string",
      "pattern": "^/(var/)?run/secrets/[^\\x00\\r\\n]+$",
      "maxLength": 512
    },
    "tls_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_name", "ca_file", "certificate_file", "private_key_file"],
      "properties": {
        "server_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9]([A-Za-z0-9.-]*[A-Za-z0-9])?\\.svc\\.cluster\\.local$",
          "maxLength": 253
        },
        "ca_file": {
          "type": "string",
          "pattern": "^/var/run/(config|secrets)/[^\\x00\\r\\n]+$",
          "maxLength": 512
        },
        "certificate_file": {"$ref": "#/$defs/secret_file"},
        "private_key_file": {"$ref": "#/$defs/secret_file"}
      }
    },
    "session_message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "content"],
      "properties": {
        "role": {"enum": ["USER", "ASSISTANT", "SYSTEM"]},
        "content": {"type": "string", "maxLength": 65536}
      }
    },
    "delegation_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "name", "purpose", "role_description"],
      "properties": {
        "ref": {"$ref": "#/$defs/opaque_ref"},
        "name": {"type": "string", "minLength": 1, "maxLength": 160},
        "purpose": {"type": "string", "maxLength": 2000},
        "role_description": {"type": "string", "maxLength": 2000},
        "workflow_step_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,95}$"
        },
        "workflow_step_name": {"type": "string", "maxLength": 160},
        "instructions": {"type": "string", "maxLength": 1000},
        "expected_result": {"type": "string", "maxLength": 1000}
      }
    },
    "integration_grant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "connection_ref",
        "definition_key",
        "connection_name",
        "capability_key",
        "capability_name",
        "capability_description",
        "risk"
      ],
      "properties": {
        "ref": {"$ref": "#/$defs/opaque_ref"},
        "connection_ref": {"$ref": "#/$defs/opaque_ref"},
        "definition_key": {"type": "string", "minLength": 1, "maxLength": 128},
        "connection_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "capability_key": {"type": "string", "minLength": 1, "maxLength": 255},
        "capability_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "capability_description": {"type": "string", "maxLength": 2000},
        "risk": {"enum": ["LOW", "MEDIUM", "HIGH"]}
      }
    },
    "assistant_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["route", "entity_kind", "entity_ref", "entity_name", "allowed_operations"],
      "properties": {
        "route": {"type": "string", "maxLength": 500},
        "entity_kind": {"type": "string", "maxLength": 80},
        "entity_ref": {"type": "string", "maxLength": 96},
        "entity_name": {"type": "string", "maxLength": 300},
        "entity_version": {"type": "integer", "minimum": 1},
        "allowed_operations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        }
      },
      "oneOf": [
        {
          "properties": {"entity_kind": {"const": ""}, "entity_ref": {"const": ""}}
        },
        {
          "properties": {
            "entity_kind": {"type": "string", "minLength": 1},
            "entity_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "file_name", "media_type", "digest", "size_bytes", "revision", "version", "scope", "position", "source"],
      "properties": {
        "ref": {"$ref": "#/$defs/opaque_ref"},
        "file_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "not": {"enum": [".", ".."]},
          "pattern": "^[^/\\\\\\x00\\r\\n]+$"
        },
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "digest": {"$ref": "#/$defs/image_digest"},
        "size_bytes": {"type": "integer", "minimum": 0, "maximum": 536870912},
        "revision": {"type": "integer", "minimum": 1},
        "version": {"type": "integer", "minimum": 1},
        "scope": {"enum": ["INPUT", "SESSION", "KNOWLEDGE"]},
        "position": {"type": "integer", "minimum": 1},
        "source": {"enum": ["CONTROL_CENTER", "AGENT_RESULT", "INTEGRATION_RESULT", "KNOWLEDGE_SOURCE", "INTERACTION_ATTACHMENT"]}
      }
    },
    "environment_name": {
      "type": "string",
      "pattern": "^[A-Z_][A-Z0-9_]{0,126}$",
      "not": {
        "anyOf": [
          {"pattern": "^(KODEX_|CODEX_|OPENAI_|OTEL_|AWS_|AZURE_|GOOGLE_|KUBERNETES_)"},
          {"enum": [
            "HOME", "PATH", "PWD", "SHELL", "USER", "LOGNAME", "TMPDIR",
            "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "SSL_CERT_FILE", "SSL_CERT_DIR"
          ]}
        ]
      }
    },
    "environment_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"$ref": "#/$defs/environment_name"},
        "value": {"type": "string", "maxLength": 8192, "not": {"pattern": "\\x00"}}
      }
    },
    "secret_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "secret_name",
        "secret_key",
        "secret_uid",
        "secret_resource_version",
        "content_sha256"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/environment_name"},
        "secret_name": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[-a-z0-9.]{0,251}[a-z0-9])?$"
        },
        "secret_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$"},
        "secret_uid": {"type": "string", "minLength": 1, "maxLength": 128},
        "secret_resource_version": {"type": "string", "minLength": 1, "maxLength": 128},
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
