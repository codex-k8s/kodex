{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattercodex.dev/contracts/runtime/legacy-data-migration/v1/manifest.schema.json",
  "title": "MatterCodex legacy data backup manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "planId", "sourceSha256", "backupSha256", "backupBytes",
    "tableCounts", "createdAt", "restoreCheck"
  ],
  "properties": {
    "schemaVersion": {"const": "mattercodex.legacy-data-backup-manifest.v1"},
    "planId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{15,127}$"},
    "sourceSha256": {"$ref": "#/$defs/sha256"},
    "backupSha256": {"$ref": "#/$defs/sha256"},
    "backupBytes": {"type": "integer", "minimum": 1},
    "tableCounts": {
      "type": "object",
      "propertyNames": {"pattern": "^matter_codex_[a-z0-9_]+$"},
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "createdAt": {"type": "string", "format": "date-time"},
    "restoreCheck": {"const": "pg_restore_list_verified"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
