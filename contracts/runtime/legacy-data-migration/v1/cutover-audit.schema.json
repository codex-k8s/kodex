{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattercodex.dev/contracts/runtime/legacy-data-migration/v1/cutover-audit.schema.json",
  "title": "MatterCodex legacy data cutover audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "planId", "planSha256", "sourceSha256", "targetSha256",
    "backupSha256", "manifestSha256", "materializationSha256", "materializationCount",
    "sourceState", "targetState", "outcome", "recordedAt"
  ],
  "properties": {
    "schemaVersion": {"const": "mattercodex.legacy-data-cutover-audit.v1"},
    "planId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{15,127}$"},
    "planSha256": {"$ref": "#/$defs/sha256"},
    "sourceSha256": {"$ref": "#/$defs/sha256"},
    "targetSha256": {"$ref": "#/$defs/sha256"},
    "backupSha256": {"$ref": "#/$defs/sha256"},
    "manifestSha256": {"$ref": "#/$defs/sha256"},
    "materializationSha256": {"$ref": "#/$defs/sha256"},
    "materializationCount": {"type": "integer", "minimum": 1, "maximum": 2000},
    "sourceState": {"enum": ["MISSING", "ABORTED", "COMMITTED"]},
    "targetState": {"enum": ["ABORTED", "COMMITTED"]},
    "outcome": {"enum": ["aborted", "verified-replay"]},
    "recordedAt": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"outcome": {"const": "aborted"}}},
      "then": {
        "properties": {
          "sourceState": {"enum": ["MISSING", "ABORTED"]},
          "targetState": {"const": "ABORTED"}
        }
      }
    },
    {
      "if": {"properties": {"outcome": {"const": "verified-replay"}}},
      "then": {
        "properties": {
          "sourceState": {"const": "COMMITTED"},
          "targetState": {"const": "COMMITTED"}
        }
      }
    }
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
