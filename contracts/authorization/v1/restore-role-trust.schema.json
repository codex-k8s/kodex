{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kodex.dev/contracts/authorization/v1/restore-role-trust.schema.json",
  "title": "Проверяемый trust snapshot signer ключей restore role credential",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "aud",
    "source_revision",
    "key_set_revision",
    "trust_set_digest_sha256",
    "predecessor",
    "history",
    "manifest_signer_generation",
    "keys",
    "published_at",
    "valid_until"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "iss": {
      "const": "spiffe://kodex.local/ns/kodex-system/sa/internal-rpc-authority-publisher"
    },
    "aud": {
      "const": "urn:kodex:internal-rpc-authority-restore-controller"
    },
    "source_revision": {
      "$ref": "#/$defs/positiveRevision"
    },
    "key_set_revision": {
      "$ref": "#/$defs/positiveRevision"
    },
    "trust_set_digest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "predecessor": {
      "$ref": "#/$defs/historyEntry"
    },
    "history": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/historyEntry"
      }
    },
    "manifest_signer_generation": {
      "$ref": "#/$defs/positiveRevision"
    },
    "keys": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/trustKey"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "status": {
                "const": "CURRENT"
              }
            },
            "required": [
              "status"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "status": {
                "const": "NEXT"
              }
            },
            "required": [
              "status"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "status": {
                "const": "PREVIOUS"
              }
            },
            "required": [
              "status"
            ]
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    },
    "published_at": {
      "type": "integer"
    },
    "valid_until": {
      "type": "integer"
    }
  },
  "$defs": {
    "positiveRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "historyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "digest_sha256"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "digest_sha256": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "use",
        "key_ops",
        "alg",
        "kid",
        "x",
        "y"
      ],
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "use": {
          "const": "sig"
        },
        "key_ops": {
          "const": [
            "verify"
          ]
        },
        "alg": {
          "const": "ES256"
        },
        "kid": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    },
    "trustKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "credential_signer_generation",
        "kid",
        "public_jwk",
        "jwk_thumbprint_sha256",
        "not_before",
        "not_after"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT",
            "NEXT",
            "PREVIOUS"
          ]
        },
        "credential_signer_generation": {
          "$ref": "#/$defs/positiveRevision"
        },
        "kid": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "public_jwk": {
          "$ref": "#/$defs/publicJwk"
        },
        "jwk_thumbprint_sha256": {
          "$ref": "#/$defs/digest"
        },
        "not_before": {
          "type": "integer"
        },
        "not_after": {
          "type": "integer"
        }
      }
    }
  }
}
