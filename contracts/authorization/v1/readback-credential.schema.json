{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattercodex.dev/contracts/authorization/v1/readback-credential.schema.json",
  "title": "Отдельный role-bound credential обычного authority readback",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "v",
    "iss",
    "aud",
    "sub",
    "jti",
    "purpose",
    "intent_id",
    "intent_kind",
    "intent_revision",
    "intent_digest_sha256",
    "workload_id",
    "workload_spiffe_id",
    "role",
    "workload_generation",
    "credential_generation",
    "material_generation",
    "possession_key_kid",
    "possession_key_generation",
    "possession_public_jwk",
    "possession_key_thumbprint_sha256",
    "credential_signer_source_revision",
    "credential_signer_source_digest_sha256",
    "credential_signer_key_set_revision",
    "credential_signer_generation",
    "iat",
    "nbf",
    "exp"
  ],
  "properties": {
    "v": {
      "const": 1
    },
    "iss": {
      "const": "spiffe://mattercodex.local/ns/mattercodex-system/sa/internal-rpc-authority-publisher"
    },
    "aud": {
      "const": "urn:mattercodex:internal-rpc-authority-readback-attestor"
    },
    "sub": {
      "$ref": "#/$defs/boundedIdentity"
    },
    "jti": {
      "type": "string",
      "format": "uuid"
    },
    "purpose": {
      "enum": [
        "KEY_DELIVERY_READBACK",
        "SNAPSHOT_READBACK"
      ]
    },
    "intent_id": {
      "type": "string",
      "format": "uuid"
    },
    "intent_kind": {
      "enum": [
        "KEY_DELIVERY",
        "SNAPSHOT"
      ]
    },
    "intent_revision": {
      "$ref": "#/$defs/positiveRevision"
    },
    "intent_digest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "workload_id": {
      "$ref": "#/$defs/boundedIdentity"
    },
    "workload_spiffe_id": {
      "$ref": "#/$defs/spiffeId"
    },
    "role": {
      "enum": [
        "AUTHORIZATION_ISSUER",
        "AUTHORIZATION_VERIFIER",
        "AUTHORITY_PROOF_RESOLVER"
      ]
    },
    "workload_generation": {
      "$ref": "#/$defs/positiveRevision"
    },
    "credential_generation": {
      "$ref": "#/$defs/positiveRevision"
    },
    "material_generation": {
      "$ref": "#/$defs/positiveRevision"
    },
    "possession_key_kid": {
      "$ref": "#/$defs/kid"
    },
    "possession_key_generation": {
      "$ref": "#/$defs/positiveRevision"
    },
    "possession_public_jwk": {
      "$ref": "#/$defs/publicJwk"
    },
    "possession_key_thumbprint_sha256": {
      "$ref": "#/$defs/digest"
    },
    "credential_signer_source_revision": {
      "$ref": "#/$defs/positiveRevision"
    },
    "credential_signer_source_digest_sha256": {
      "$ref": "#/$defs/digest"
    },
    "credential_signer_key_set_revision": {
      "$ref": "#/$defs/positiveRevision"
    },
    "credential_signer_generation": {
      "$ref": "#/$defs/positiveRevision"
    },
    "iat": {
      "type": "integer"
    },
    "nbf": {
      "type": "integer"
    },
    "exp": {
      "type": "integer"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "KEY_DELIVERY_READBACK"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "intent_kind": {
            "const": "KEY_DELIVERY"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "purpose": {
            "const": "SNAPSHOT_READBACK"
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "properties": {
          "intent_kind": {
            "const": "SNAPSHOT"
          }
        }
      }
    }
  ],
  "$defs": {
    "boundedIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "spiffeId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "pattern": "^spiffe://mattercodex[.]local/"
    },
    "positiveRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kid": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "publicJwk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kty",
        "crv",
        "use",
        "key_ops",
        "alg",
        "kid",
        "x",
        "y"
      ],
      "properties": {
        "kty": {
          "const": "EC"
        },
        "crv": {
          "const": "P-256"
        },
        "use": {
          "const": "sig"
        },
        "key_ops": {
          "const": [
            "verify"
          ]
        },
        "alg": {
          "const": "ES256"
        },
        "kid": {
          "$ref": "#/$defs/kid"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{43}$"
        }
      }
    }
  }
}
