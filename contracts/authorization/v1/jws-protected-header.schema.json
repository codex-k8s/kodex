{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattercodex.dev/contracts/authorization/v1/jws-protected-header.schema.json",
  "title": "Защищенный JWS header внутреннего RPC MatterCodex",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alg",
    "typ",
    "kid",
    "crit",
    "mcxv"
  ],
  "properties": {
    "alg": {
      "const": "ES256"
    },
    "typ": {
      "enum": [
        "mattercodex-internal-rpc-auth+jws",
        "mattercodex-internal-rpc-snapshot+jws"
      ]
    },
    "kid": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{1,62}[a-z0-9])$"
    },
    "crit": {
      "type": "array",
      "prefixItems": [
        {
          "const": "mcxv"
        }
      ],
      "items": false,
      "minItems": 1,
      "maxItems": 1
    },
    "mcxv": {
      "const": 1
    }
  }
}
