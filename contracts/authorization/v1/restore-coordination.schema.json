{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattercodex.dev/contracts/authorization/v1/restore-coordination.schema.json",
  "title": "Claims координации PITR MatterCodex",
  "oneOf": [
    {
      "$ref": "#/$defs/roleCredential"
    },
    {
      "$ref": "#/$defs/directive"
    },
    {
      "$ref": "#/$defs/quiescenceAck"
    }
  ],
  "$defs": {
    "boundedIdentity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "positiveRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "role": {
      "enum": [
        "AUTHORIZATION_ISSUER",
        "AUTHORIZATION_VERIFIER",
        "AUTHORITY_PROOF_RESOLVER"
      ]
    },
    "spiffeId": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "pattern": "^spiffe://mattercodex[.]local/"
    },
    "roleCredential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "iss",
        "aud",
        "sub",
        "jti",
        "workload_id",
        "workload_spiffe_id",
        "role",
        "workload_generation",
        "credential_generation",
        "ack_key_thumbprint_sha256",
        "iat",
        "nbf",
        "exp"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "iss": {
          "const": "spiffe://mattercodex.local/ns/mattercodex-system/sa/internal-rpc-authority-publisher"
        },
        "aud": {
          "const": "urn:mattercodex:internal-rpc-authority-restore-controller"
        },
        "sub": {
          "$ref": "#/$defs/boundedIdentity"
        },
        "jti": {
          "type": "string",
          "format": "uuid"
        },
        "workload_id": {
          "$ref": "#/$defs/boundedIdentity"
        },
        "workload_spiffe_id": {
          "$ref": "#/$defs/spiffeId"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "workload_generation": {
          "$ref": "#/$defs/positiveRevision"
        },
        "credential_generation": {
          "$ref": "#/$defs/positiveRevision"
        },
        "ack_key_thumbprint_sha256": {
          "$ref": "#/$defs/digest"
        },
        "iat": {
          "type": "integer"
        },
        "nbf": {
          "type": "integer"
        },
        "exp": {
          "type": "integer"
        }
      }
    },
    "directive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "iss",
        "aud",
        "sub",
        "jti",
        "restore_id",
        "restore_epoch",
        "coordination_revision",
        "phase",
        "workload_id",
        "workload_spiffe_id",
        "role",
        "workload_generation",
        "role_credential_digest_sha256",
        "stop_accepting_required",
        "drain_inflight_required",
        "iat",
        "nbf",
        "exp"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "iss": {
          "const": "spiffe://mattercodex.local/ns/mattercodex-system/sa/internal-rpc-authority-restore-controller"
        },
        "aud": {
          "const": "urn:mattercodex:internal-rpc-authority-restore-controller"
        },
        "sub": {
          "$ref": "#/$defs/boundedIdentity"
        },
        "jti": {
          "type": "string",
          "format": "uuid"
        },
        "restore_id": {
          "type": "string",
          "format": "uuid"
        },
        "restore_epoch": {
          "$ref": "#/$defs/positiveRevision"
        },
        "coordination_revision": {
          "$ref": "#/$defs/positiveRevision"
        },
        "phase": {
          "const": "QUIESCING"
        },
        "workload_id": {
          "$ref": "#/$defs/boundedIdentity"
        },
        "workload_spiffe_id": {
          "$ref": "#/$defs/spiffeId"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "workload_generation": {
          "$ref": "#/$defs/positiveRevision"
        },
        "role_credential_digest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "stop_accepting_required": {
          "const": true
        },
        "drain_inflight_required": {
          "const": true
        },
        "iat": {
          "type": "integer"
        },
        "nbf": {
          "type": "integer"
        },
        "exp": {
          "type": "integer"
        }
      }
    },
    "quiescenceAck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "iss",
        "aud",
        "sub",
        "jti",
        "directive_jti",
        "restore_id",
        "restore_epoch",
        "coordination_revision",
        "workload_id",
        "workload_spiffe_id",
        "role",
        "workload_generation",
        "role_credential_digest_sha256",
        "served_snapshot_digest_sha256",
        "accepting_stopped",
        "inflight_drained",
        "inflight_count",
        "iat",
        "nbf",
        "exp"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "iss": {
          "$ref": "#/$defs/spiffeId"
        },
        "aud": {
          "const": "urn:mattercodex:internal-rpc-authority-restore-controller"
        },
        "sub": {
          "$ref": "#/$defs/boundedIdentity"
        },
        "jti": {
          "type": "string",
          "format": "uuid"
        },
        "directive_jti": {
          "type": "string",
          "format": "uuid"
        },
        "restore_id": {
          "type": "string",
          "format": "uuid"
        },
        "restore_epoch": {
          "$ref": "#/$defs/positiveRevision"
        },
        "coordination_revision": {
          "$ref": "#/$defs/positiveRevision"
        },
        "workload_id": {
          "$ref": "#/$defs/boundedIdentity"
        },
        "workload_spiffe_id": {
          "$ref": "#/$defs/spiffeId"
        },
        "role": {
          "$ref": "#/$defs/role"
        },
        "workload_generation": {
          "$ref": "#/$defs/positiveRevision"
        },
        "role_credential_digest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "served_snapshot_digest_sha256": {
          "$ref": "#/$defs/digest"
        },
        "accepting_stopped": {
          "const": true
        },
        "inflight_drained": {
          "const": true
        },
        "inflight_count": {
          "const": 0
        },
        "iat": {
          "type": "integer"
        },
        "nbf": {
          "type": "integer"
        },
        "exp": {
          "type": "integer"
        }
      }
    }
  }
}
