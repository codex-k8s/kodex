{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mattercodex.dev/contracts/authorization/v1/key-delivery-targets.schema.json",
  "title": "Точные workload/role targets internal-rpc-authority",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "source_revision",
    "targets"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "targets": {
      "type": "array",
      "minItems": 0,
      "maxItems": 384,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/target"
      }
    }
  },
  "$defs": {
    "workloadId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{1,94}[a-z0-9])$"
    },
    "spiffeId": {
      "type": "string",
      "minLength": 12,
      "maxLength": 512,
      "pattern": "^spiffe://[a-z0-9.-]+(?:/[A-Za-z0-9._~-]+)+$"
    },
    "kubernetesName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9.-]{0,61}[a-z0-9])?$"
    },
    "databasePrincipal": {
      "type": "string",
      "minLength": 8,
      "maxLength": 63,
      "pattern": "^ira_[a-z0-9_]+_(issuer|verifier|resolver)_g[1-9][0-9]*$"
    },
    "vaultPath": {
      "type": "string",
      "minLength": 16,
      "maxLength": 512,
      "pattern": "^kv/data/mattercodex/[a-z0-9][a-z0-9./_-]*[a-z0-9]$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 2,
      "maxLength": 512,
      "pattern": "^/(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vault_path",
        "secret_name",
        "mount_path"
      ],
      "properties": {
        "vault_path": {
          "$ref": "#/$defs/vaultPath"
        },
        "secret_name": {
          "$ref": "#/$defs/kubernetesName"
        },
        "mount_path": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "secret_name",
        "mount_path"
      ],
      "properties": {
        "secret_name": {
          "$ref": "#/$defs/kubernetesName"
        },
        "mount_path": {
          "$ref": "#/$defs/absolutePath"
        }
      }
    },
    "databaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "login_principal",
        "vault_database_role",
        "dsn_mount_path",
        "credential_generation"
      ],
      "properties": {
        "login_principal": {
          "$ref": "#/$defs/databasePrincipal"
        },
        "vault_database_role": {
          "$ref": "#/$defs/kubernetesName"
        },
        "dsn_mount_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "credential_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "readback_id",
        "credential_id",
        "credential_vault_path",
        "credential_mount_path",
        "credential_protected_type",
        "credential_schema",
        "possession_key_id",
        "possession_key_generation",
        "intent_revision",
        "material_generation",
        "possession_key_vault_path",
        "possession_key_mount_path",
        "possession_public_jwk_source",
        "database_function",
        "snapshot_database_function",
        "attestor_address",
        "attestor_tls_server_name",
        "attestor_trust_bundle_id",
        "attestor_ca_mount_path",
        "attestor_audience",
        "attestor_challenge_full_method",
        "attestor_full_method",
        "expected_role",
        "network_policy"
      ],
      "properties": {
        "readback_id": {
          "$ref": "#/$defs/workloadId"
        },
        "credential_id": {
          "$ref": "#/$defs/workloadId"
        },
        "credential_vault_path": {
          "$ref": "#/$defs/vaultPath"
        },
        "credential_mount_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "credential_protected_type": {
          "const": "mattercodex-internal-rpc-readback-credential+jws"
        },
        "credential_schema": {
          "const": "contracts/authorization/v1/readback-credential.schema.json"
        },
        "possession_key_id": {
          "$ref": "#/$defs/workloadId"
        },
        "possession_key_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "intent_revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "material_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "possession_key_vault_path": {
          "$ref": "#/$defs/vaultPath"
        },
        "possession_key_mount_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "possession_public_jwk_source": {
          "const": "SIGNED_NORMAL_READBACK_CREDENTIAL"
        },
        "database_function": {
          "const": "internal_rpc_authority.record_authority_key_delivery_readback(uuid)"
        },
        "snapshot_database_function": {
          "const": "internal_rpc_authority.record_authority_snapshot_readback(uuid)"
        },
        "attestor_address": {
          "const": "internal-rpc-authority-readback-attestor.mattercodex-system.svc:8443"
        },
        "attestor_tls_server_name": {
          "const": "internal-rpc-authority-readback-attestor.mattercodex-system.svc"
        },
        "attestor_trust_bundle_id": {
          "const": "internal-rpc-authority-readback-attestor-ca"
        },
        "attestor_ca_mount_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "attestor_audience": {
          "const": "urn:mattercodex:internal-rpc-authority-readback-attestor"
        },
        "attestor_challenge_full_method": {
          "const": "/internalrpcauthority.v1.AuthorityReadbackAttestorService/IssueAttestationChallenge"
        },
        "attestor_full_method": {
          "const": "/internalrpcauthority.v1.AuthorityReadbackAttestorService/AttestServedState"
        },
        "expected_role": {
          "enum": [
            "AUTHORIZATION_ISSUER",
            "AUTHORIZATION_VERIFIER",
            "AUTHORITY_PROOF_RESOLVER"
          ]
        },
        "network_policy": {
          "$ref": "#/$defs/kubernetesName"
        }
      }
    },
    "restoreCoordination": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role_credential_id",
        "role_credential_vault_path",
        "role_credential_mount_path",
        "ack_key_id",
        "ack_key_generation",
        "ack_key_vault_path",
        "ack_key_mount_path",
        "ack_public_jwk_source",
        "controller_address",
        "controller_tls_server_name",
        "controller_trust_bundle_id",
        "controller_ca_mount_path",
        "controller_audience",
        "controller_full_method",
        "network_policy"
      ],
      "properties": {
        "role_credential_id": {
          "$ref": "#/$defs/workloadId"
        },
        "role_credential_vault_path": {
          "$ref": "#/$defs/vaultPath"
        },
        "role_credential_mount_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "ack_key_id": {
          "$ref": "#/$defs/workloadId"
        },
        "ack_key_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "ack_key_vault_path": {
          "$ref": "#/$defs/vaultPath"
        },
        "ack_key_mount_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "ack_public_jwk_source": {
          "const": "SIGNED_ROLE_CREDENTIAL"
        },
        "controller_address": {
          "const": "internal-rpc-authority-restore-controller.mattercodex-system.svc:8443"
        },
        "controller_tls_server_name": {
          "const": "internal-rpc-authority-restore-controller.mattercodex-system.svc"
        },
        "controller_trust_bundle_id": {
          "const": "internal-rpc-authority-restore-controller-ca"
        },
        "controller_ca_mount_path": {
          "$ref": "#/$defs/absolutePath"
        },
        "controller_audience": {
          "const": "urn:mattercodex:internal-rpc-authority-restore-controller"
        },
        "controller_full_method": {
          "const": "/internalrpcauthority.v1.RestoreControllerService/GetRestoreDirective"
        },
        "network_policy": {
          "$ref": "#/$defs/kubernetesName"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "role",
        "spiffe_id",
        "namespace",
        "service_account",
        "workload_generation",
        "authority_snapshot",
        "manifest_trust",
        "database_identity",
        "restore_coordination",
        "readback"
      ],
      "properties": {
        "workload_id": {
          "$ref": "#/$defs/workloadId"
        },
        "role": {
          "enum": [
            "AUTHORIZATION_ISSUER",
            "AUTHORIZATION_VERIFIER",
            "AUTHORITY_PROOF_RESOLVER"
          ]
        },
        "spiffe_id": {
          "$ref": "#/$defs/spiffeId"
        },
        "namespace": {
          "$ref": "#/$defs/kubernetesName"
        },
        "service_account": {
          "$ref": "#/$defs/kubernetesName"
        },
        "workload_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "authority_snapshot": {
          "$ref": "#/$defs/projection"
        },
        "auth_private_key": {
          "$ref": "#/$defs/delivery"
        },
        "authority_proof_private_key": {
          "$ref": "#/$defs/delivery"
        },
        "manifest_trust": {
          "$ref": "#/$defs/delivery"
        },
        "authority_proof_trust": {
          "$ref": "#/$defs/delivery"
        },
        "database_identity": {
          "$ref": "#/$defs/databaseIdentity"
        },
        "restore_coordination": {
          "$ref": "#/$defs/restoreCoordination"
        },
        "readback": {
          "$ref": "#/$defs/readback"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "AUTHORIZATION_ISSUER"
              }
            }
          },
          "then": {
            "required": [
              "auth_private_key",
              "authority_proof_trust"
            ],
            "properties": {
              "readback": {
                "properties": {
                  "expected_role": {
                    "const": "AUTHORIZATION_ISSUER"
                  }
                }
              }
            },
            "not": {
              "required": [
                "authority_proof_private_key"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "AUTHORIZATION_VERIFIER"
              }
            }
          },
          "then": {
            "properties": {
              "readback": {
                "properties": {
                  "expected_role": {
                    "const": "AUTHORIZATION_VERIFIER"
                  }
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "auth_private_key"
                  ]
                },
                {
                  "required": [
                    "authority_proof_private_key"
                  ]
                },
                {
                  "required": [
                    "authority_proof_trust"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "AUTHORITY_PROOF_RESOLVER"
              }
            }
          },
          "then": {
            "required": [
              "authority_proof_private_key",
              "authority_proof_trust"
            ],
            "properties": {
              "readback": {
                "properties": {
                  "expected_role": {
                    "const": "AUTHORITY_PROOF_RESOLVER"
                  }
                }
              }
            },
            "not": {
              "required": [
                "auth_private_key"
              ]
            }
          }
        }
      ]
    }
  }
}
