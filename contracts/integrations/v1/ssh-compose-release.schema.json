{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/codex-k8s/kodex/contracts/integrations/v1/ssh-compose-release.schema.json",
  "title": "Ограниченный manifest SSH/Compose релиза",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "command",
    "containerPort",
    "healthPath"
  ],
  "x-kodex-maximum-encoded-bytes": 4096,
  "properties": {
    "image": {
      "type": "string",
      "maxLength": 313,
      "pattern": "^[a-z0-9][a-z0-9./:_-]{0,240}@sha256:[a-f0-9]{64}$"
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "x-kodex-maximum-utf8-bytes": 256,
        "not": {
          "pattern": "[$\\r\\n\\u0000]"
        }
      }
    },
    "containerPort": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 65535
    },
    "healthPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "x-kodex-maximum-utf8-bytes": 120,
      "pattern": "^/",
      "allOf": [
        {
          "not": {
            "pattern": "\\.\\."
          }
        },
        {
          "not": {
            "pattern": "[?#\\r\\n\\\\\\u0000]"
          }
        }
      ]
    }
  }
}
