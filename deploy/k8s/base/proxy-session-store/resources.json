                "port": 6379
              }
            ]
          }
        ],
        "egress": []
      }
    },
    {
      "apiVersion": "networking.k8s.io/v1",
      "kind": "NetworkPolicy",
      "metadata": {
        "name": "oauth2-control-center-session-store",
        "namespace": "kodex-system",
        "labels": {
          "app.kubernetes.io/name": "proxy-session-store",
          "app.kubernetes.io/part-of": "kodex",
          "kodex.io/owner": "management-surfaces"
        }
      },
      "spec": {
        "podSelector": {
          "matchLabels": {
            "app.kubernetes.io/name": "oauth2-proxy",
            "app.kubernetes.io/instance": "oauth2-control-center"
          }
        },
        "policyTypes": ["Egress"],
        "egress": [
          {
            "to": [
              {
                "podSelector": {
                  "matchLabels": {
                    "app.kubernetes.io/name": "proxy-session-store"
                  }
                }
              }
            ],
            "ports": [
              {
                "protocol": "TCP",
                "port": 6379
              }
            ]
          }
        ]
      }
    }
  ]
}
