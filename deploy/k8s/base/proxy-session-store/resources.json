        "namespace": "kodex-system",
        "labels": {
          "app.kubernetes.io/name": "proxy-session-store",
          "app.kubernetes.io/part-of": "kodex",
          "kodex.io/owner": "management-surfaces"
        }
      },
      "spec": {
        "selector": {
          "app.kubernetes.io/name": "proxy-session-store"
        },
        "ports": [
          {
            "name": "rediss",
            "port": 6379,
            "targetPort": "rediss"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "proxy-session-store",
        "namespace": "kodex-system",
        "labels": {
          "app.kubernetes.io/name": "proxy-session-store",
          "app.kubernetes.io/part-of": "kodex",
          "kodex.io/owner": "management-surfaces"
        }
      },
      "spec": {
        "serviceName": "proxy-session-store",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "proxy-session-store"
          }
        },
        "updateStrategy": {
          "type": "OnDelete"
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/name": "proxy-session-store",
              "app.kubernetes.io/part-of": "kodex",
              "kodex.io/owner": "management-surfaces"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "terminationGracePeriodSeconds": 45,
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 1000,
              "runAsGroup": 1000,
              "fsGroup": 1000,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "containers": [
              {
                "name": "valkey",
                "image": "docker.io/valkey/valkey:8.1.3-alpine@sha256:d827e7f7552cdee40cc7482dbae9da020f42bc47669af6f71182a4ef76a22773",
                "command": ["valkey-server", "/config/valkey.conf"],
                "ports": [
                  {
                    "name": "rediss",
                    "containerPort": 6379
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "64Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                },
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "readOnlyRootFilesystem": true,
                  "capabilities": {
                    "drop": ["ALL"]
                  }
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/data"
                  },
                  {
                    "name": "config",
                    "mountPath": "/config",
                    "readOnly": true
                  },
                  {
                    "name": "auth",
                    "mountPath": "/auth",
                    "readOnly": true
                  },
                  {
                    "name": "tls",
                    "mountPath": "/tls",
                    "readOnly": true
                  }
                ],
                "startupProbe": {
                  "exec": {
                    "command": ["sh", "/config/ops.sh", "ready"]
                  },
                  "periodSeconds": 3,
                  "failureThreshold": 40,
                  "timeoutSeconds": 3
                },
                "readinessProbe": {
                  "exec": {
                    "command": ["sh", "/config/ops.sh", "ready"]
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 2,
                  "timeoutSeconds": 3
                },
                "livenessProbe": {
                  "exec": {
                    "command": ["sh", "-c", "kill -0 1"]
                  },
                  "periodSeconds": 15,
                  "failureThreshold": 3,
                  "timeoutSeconds": 1
                }
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "proxy-session-store-data"
                }
              },
              {
                "name": "config",
                "configMap": {
                  "name": "proxy-session-store",
                  "defaultMode": 292
                }
              },
              {
                "name": "auth",
                "secret": {
                  "secretName": "proxy-session-store-auth-v1",
                  "defaultMode": 288
                }
              },
              {
                "name": "tls",
                "secret": {
                  "secretName": "proxy-session-store-tls",
                  "defaultMode": 288
                }
              }
            ]
          }
        }
      }
