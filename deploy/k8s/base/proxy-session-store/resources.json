    {
      "apiVersion": "v1",
      "kind": "ConfigMap",
      "metadata": {
        "name": "proxy-session-store",
        "namespace": "kodex-system",
        "labels": {
          "app.kubernetes.io/name": "proxy-session-store",
          "app.kubernetes.io/part-of": "kodex",
          "kodex.io/owner": "management-surfaces"
        }
      },
      "data": {
        "valkey.conf": "bind 0.0.0.0\nprotected-mode yes\nport 0\ntls-port 6379\ntls-cert-file /tls/tls.crt\ntls-key-file /tls/tls.key\ntls-ca-cert-file /tls/ca.crt\ntls-auth-clients no\ntls-protocols \"TLSv1.2 TLSv1.3\"\naclfile /auth/users.acl\ndir /data\nappendonly yes\nappendfsync always\nno-appendfsync-on-rewrite no\nsave 300 1\nmaxmemory 128mb\nmaxmemory-policy noeviction\nloglevel notice\nlogfile \"\"\n",
        "ops.sh": "#!/bin/sh\nset -eu\nmode=${1:-}\ncase \"$mode\" in\n ready) user=probe; secret=/auth/probe-password ;;\n backup) user=backup; secret=/auth/backup-password ;;\n *) echo \"Invalid session store operation\" >&2; exit 1 ;;\nesac\nexport REDISCLI_AUTH=\"$(cat \"$secret\")\"\ncli() { valkey-cli --tls --cacert /tls/ca.crt --sni proxy-session-store.kodex-system.svc.cluster.local -h 127.0.0.1 -p 6379 --user \"$user\" \"$@\"; }\nif [ \"$mode\" = ready ]; then\n [ \"$(cli PING 2>/dev/null)\" = PONG ] || exit 1\n info=$(cli INFO persistence 2>/dev/null) || exit 1\n printf '%s' \"$info\" | tr -d '\\r' | grep -qx 'loading:0'\n printf '%s' \"$info\" | tr -d '\\r' | grep -qx 'aof_last_write_status:ok'\nelse\n [ \"$(cli SAVE 2>/dev/null)\" = OK ] || exit 1\n cat /data/dump.rdb\nfi\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "name": "proxy-session-store-data",
        "namespace": "kodex-system",
        "labels": {
          "app.kubernetes.io/name": "proxy-session-store",
          "app.kubernetes.io/part-of": "kodex",
          "kodex.io/owner": "management-surfaces"
        }
      },
      "spec": {
        "accessModes": ["ReadWriteOnce"],
        "resources": {
          "requests": {
            "storage": "1Gi"
          }
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
