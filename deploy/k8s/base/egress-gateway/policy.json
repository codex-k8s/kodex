{
  "apiVersion": "kodex.io/v1alpha1",
  "kind": "EgressGatewayPolicy",
  "metadata": {
    "name": "egress-gateway",
    "revision": "2026-08-07.1"
  },
  "spec": {
    "dns": {
      "minimumTTLSeconds": 30,
      "maximumTTLSeconds": 300,
      "maximumCacheEntries": 32,
      "maximumQueries": 12,
      "maximumCnameDepth": 8,
      "maximumRecords": 64,
      "maximumMessageBytes": 16384,
      "queryTimeoutMilliseconds": 2000
    },
    "limits": {
      "maximumHeaderBytes": 16384,
      "maximumClientHelloBytes": 65536,
      "maximumConnections": 256,
      "maximumConnectionsPerSource": 32,
      "headerTimeoutMilliseconds": 5000,
      "clientHelloTimeoutMilliseconds": 5000,
      "dialTimeoutMilliseconds": 5000,
      "idleTimeoutMilliseconds": 300000,
      "writeTimeoutMilliseconds": 5000,
      "shutdownTimeoutMilliseconds": 20000
    },
    "destinations": [
      {"hostname": "api.openai.com", "port": 443},
      {"hostname": "auth.openai.com", "port": 443},
      {"hostname": "chatgpt.com", "port": 443},
      {"hostname": "github.com", "port": 443}
    ]
  }
}
